{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"values": []},
  "title": {
    "text": "Value concentration compared with reference",
    "subtitle": "Direct aggregate curve overlay; the reference is contextual evidence, not truth"
  },
  "mark": {"type": "line", "point": false},
  "encoding": {
    "column": {"field": "column_name", "type": "nominal", "title": "PII field", "sort": {"field": "column_order", "order": "ascending"}},
    "x": {"field": "cumulative_distinct_value_share", "type": "quantitative", "title": "Cumulative share of distinct values", "scale": {"domain": [0, 1]}, "axis": {"format": ".0%"}},
    "y": {"field": "cumulative_record_share", "type": "quantitative", "title": "Cumulative share of observed records", "scale": {"domain": [0, 1]}, "axis": {"format": ".0%"}},
    "color": {"field": "profile_label", "type": "nominal", "title": "Profile"},
    "tooltip": [
      {"field": "profile_label", "type": "nominal", "title": "Profile"},
      {"field": "source_dataset", "type": "nominal", "title": "Input"},
      {"field": "column_name", "type": "nominal", "title": "PII field"},
      {"field": "value_rank", "type": "quantitative", "title": "Value rank", "format": ","},
      {"field": "cumulative_distinct_value_share", "type": "quantitative", "title": "Distinct-value share", "format": ".1%"},
      {"field": "cumulative_record_share", "type": "quantitative", "title": "Record share", "format": ".1%"}
    ]
  },
  "config": {"view": {"stroke": null}}
}
